{
  "expo": {
    "name": "REACT",
    "slug": "reactapp",
    "version": "1.0.0",
    "owner": "smashlab-uf",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smashlab.react",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "REACT uses the local network to load the development server.",
        "NSBonjourServices": ["_expo._tcp", "_metro._tcp"]
      }
    },
    "android": {
      "package": "com.smashlab.react",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2fb6977b-d72d-4501-b869-c4ec11fa2d1b"
      }
    }
  }
}
