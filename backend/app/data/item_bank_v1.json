          "response_type": "likert",
          "min_value": 1,
          "max_value": 5,
          "low_label": "Not at all",
          "high_label": "Extremely",
          "group": "B1_affect"
        },
        {
          "sub_item_id": "B1_affect_bored",
          "text": "Bored",
          "response_type": "likert",
